# Копируйте этот файл в .env и подставьте свои значения.
# Все переменные необязательны: без них используются значения по умолчанию из config.py.

# Каталог Obsidian vault для заметок о встречах
OBSIDIAN_DIR=D:\Obsidian\Vault\Meetings

# Аудио
TARGET_SAMPLE_RATE=16000
AUDIO_EXTENSIONS=.wav,.mp3,.m4a
MIC_DEVICE=audio=Микрофон (USB PnP Audio Device)
STEREO_MIX_DEVICE=audio=Стерео микшер (Realtek(R) Audio)

# Транскрибация (faster-whisper)
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=ru
WHISPER_INITIAL_PROMPT=Запись встречи на русском языке.
WHISPER_BEAM_SIZE=5
WHISPER_VAD_MIN_SILENCE_MS=500

# Саммаризация (Ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4-64k-q4:latest
OLLAMA_NUM_CTX=8192
OLLAMA_WARMUP_TIMEOUT=60
OLLAMA_TIMEOUT=300
# Шаблон промпта; плейсхолдеры {subject}, {context}, {transcript}.
# Не используйте одиночные '{' вне плейсхолдеров.
# SUMMARY_PROMPT_TEMPLATE=Ниже представлена расшифровка встречи: "{subject}".{context}

# Фоновый воркер
WORKER_POLL_INTERVAL=2
WORKER_CLEANUP_INTERVAL_HOURS=12
ARCHIVE_RETENTION_DAYS=7
MAX_TRANSCRIBE_RETRIES=3

# Календарь Outlook
OUTLOOK_LOOKBACK_MINUTES=30
OUTLOOK_LOOKAHEAD_HOURS=12